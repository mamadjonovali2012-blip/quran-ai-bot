# Токен Telegram бота (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# --- Режим запуска ---
# WEBHOOK=true — вебхук (рекомендуется для Render)
# WEBHOOK=false/пусто — polling (обычный запуск)
WEBHOOK=true

# URL вашего сервиса (без слеша в конце), например https://quran-ai-bot.onrender.com
WEBHOOK_URL=https://quran-ai-bot.onrender.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_secret_here

# URL для самопинга (не даёт Render уснуть) — тот же WEBHOOK_URL
SELF_URL=https://quran-ai-bot.onrender.com

# Порт HTTP-сервера (Render задаёт сам через PORT)
PORT=10000